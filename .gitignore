# ==========================================
# BillSplit AI - .gitignore
# ==========================================

# ── Environment & Secrets ─────────────────
.env
.env.*
!.env.example
!backend/.env.example
*.pem
*.key

# ── Python / Backend ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite / Database
*.db
*.sqlite
*.sqlite3
billsplit.db
backend/billsplit.db

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Packaging & Distribution
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# ── Node / Frontend ───────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS & Editors ──────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
